# Copy to .env and fill in real values. .env is git-ignored.

# SQLAlchemy-style database URL for the target SQL database.
DATABASE_URL=mysql+mysqlconnector://USER:PASSWORD@localhost:3306/company

# Local LLM (Ollama) settings.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# Embeddings / retrieval.
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Agent limits.
MAX_TOKENS=80000
MAX_RETRIES=3
SUMMARIZE_THRESHOLD=80000
